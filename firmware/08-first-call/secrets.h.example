// Copy to secrets.h (same folder) and fill in. Never committed to git.
#pragma once
#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-wifi-password"
// The relay running the exchange (relay/switchboard.mjs). Either the Mac on the home network
// (e.g. "192.168.1.87", port 8080, RELAY_TLS 0) or Railway ("numberplease.app", port 443, RELAY_TLS 1).
#define RELAY_HOST    "numberplease.app"
#define RELAY_PORT    443
#define RELAY_TLS     1
// Must match PHONE_TOKEN in the relay's environment (.env on the Mac, Variables on Railway).
#define PHONE_TOKEN   "the-same-long-random-string-as-the-relay"
