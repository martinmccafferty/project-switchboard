{
  "name": "switchboard-relay",
  "version": "0.2.0",
  "private": true,
  "description": "Project Switchboard AI relay: phone WebSocket server and the Operator (Claude)",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "chat": "node --env-file-if-exists=.env chat.mjs",
    "audition": "node --env-file-if-exists=.env audition.mjs",
    "roundtrip": "node --env-file-if-exists=.env roundtrip.mjs",
    "clips": "node --env-file-if-exists=.env clips.mjs",
    "cues": "node --env-file-if-exists=.env cue-demo.mjs",
    "switchboard": "node --env-file-if-exists=.env switchboard.mjs",
    "deploy": "railway up --detach --no-gitignore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "openai": "^7.53.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
