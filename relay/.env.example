# Copy this file to .env (same folder) and fill in your values. .env is never committed.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# Your household (D-35, D-38): used once, to create data/settings.json on first start; after that, change
# settings there (or, later, on the settings page). Rooms and devices: see settings.example.json and
# `node --env-file=.env switchbot.mjs --draft`. Where home is, as you'd say it; the relay finds the coordinates.
HOME_LOCATION=Springfield, Illinois
HOME_TIMEZONE=America/Chicago
# fahrenheit or celsius (wind speed follows: mph or km/h)
TEMPERATURE_UNIT=fahrenheit
# Names the transcriber should expect (people, places you mention), comma-separated
# TRANSCRIBE_KEYWORDS=Alice,Bob

# SwitchBot cloud API (M4 blinds): SwitchBot app > Profile > Preferences > tap App Version 10 times > Developer Options
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
